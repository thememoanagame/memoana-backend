<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformCommandLineArguments>--report-trx --report-trx-filename test-results.trx --coverlet --coverlet-output-format cobertura --coverlet-include "[MemoAna]*,[MemoAna.Application]*,[MemoAna.Domain]*,[MemoAna.Infrastructure]*" --coverlet-exclude "[*.Migrations]*,[*.UnitTests]*,[Mediator*]*,[FluentValidation*]*"</TestingPlatformCommandLineArguments>
    <QualityGateThreshold>80</QualityGateThreshold>
    <QualityGateResultsDirectory>$(MSBuildProjectDirectory)/TestResults/QualityGate</QualityGateResultsDirectory>
    <QualityGateReportDirectory>$(QualityGateResultsDirectory)/Report</QualityGateReportDirectory>
    <QualityGateMarkdownReport>$(QualityGateReportDirectory)/Summary.md</QualityGateMarkdownReport>
    <QualityGateTextReport>$(QualityGateReportDirectory)/Summary.txt</QualityGateTextReport>
    <QualityGateCoveragePattern>$(QualityGateResultsDirectory)/**/coverage.cobertura.xml</QualityGateCoveragePattern>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MemoAna\MemoAna.csproj" />
  </ItemGroup>

  <Target Name="ValidateQualityGate" DependsOnTargets="Build">
    <Message Importance="High" Text="============================================================" />
    <Message Importance="High" Text="MemoAna Unit Test Quality Gate (en-US)" />
    <Message Importance="High" Text="============================================================" />
    <Message Importance="High" Text="Running unit tests with code coverage..." />

    <RemoveDir Directories="$(QualityGateResultsDirectory)" />
    <MakeDir Directories="$(QualityGateResultsDirectory)" />

    <Exec
      Command="dotnet test &quot;$(MSBuildProjectFullPath)&quot; --no-build --configuration &quot;$(Configuration)&quot; --results-directory &quot;$(QualityGateResultsDirectory)&quot;"
      ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="QualityGateTestExitCode" />
    </Exec>

    <Error
      Condition="'$(QualityGateTestExitCode)' != '0'"
      Text="Quality Gate aborted: unit tests failed with exit code $(QualityGateTestExitCode)." />

    <Exec
      Command="dotnet tool run reportgenerator -reports:&quot;$(QualityGateCoveragePattern)&quot; -targetdir:&quot;$(QualityGateReportDirectory)&quot; -reporttypes:MarkdownSummary;TextSummary -assemblyfilters:&quot;+MemoAna*;-FluentValidation*;-Mediator*&quot; -minimumCoverageThresholds:lineCoverage=$(QualityGateThreshold) -minimumCoverageThresholds:branchCoverage=$(QualityGateThreshold)"
      ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="QualityGateReportGeneratorExitCode" />
    </Exec>

    <Error
      Condition="'$(QualityGateReportGeneratorExitCode)' != '0' and !Exists('$(QualityGateMarkdownReport)')"
      Text="Quality Gate aborted: ReportGenerator failed with exit code $(QualityGateReportGeneratorExitCode) and did not produce the Markdown report." />

    <Error
      Condition="!Exists('$(QualityGateMarkdownReport)')"
      Text="Quality Gate aborted: Markdown coverage report was not found at $(QualityGateMarkdownReport)." />

    <Error
      Condition="!Exists('$(QualityGateTextReport)')"
      Text="Quality Gate aborted: Text coverage report was not found at $(QualityGateTextReport)." />

    <PropertyGroup>
      <QualityGateTextContent>$([System.IO.File]::ReadAllText('$(QualityGateTextReport)'))</QualityGateTextContent>
      <QualityGateLineCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Line coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateLineCoverage>
      <QualityGateBranchCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Branch coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateBranchCoverage>
    </PropertyGroup>

    <Error
      Condition="'$(QualityGateLineCoverage)' == '' or '$(QualityGateBranchCoverage)' == ''"
      Text="Quality Gate aborted: unable to extract total line and branch coverage percentages from $(QualityGateMarkdownReport)." />

    <Message Importance="High" Text="Line Coverage:   $(QualityGateLineCoverage)% [PASSED]" Condition="'$(QualityGateLineCoverage)' &gt;= '$(QualityGateThreshold)'" />
    <Message Importance="High" Text="Line Coverage:   $(QualityGateLineCoverage)% [FAILED]" Condition="'$(QualityGateLineCoverage)' &lt; '$(QualityGateThreshold)'" />
    <Message Importance="High" Text="Branch Coverage: $(QualityGateBranchCoverage)% [PASSED]" Condition="'$(QualityGateBranchCoverage)' &gt;= '$(QualityGateThreshold)'" />
    <Message Importance="High" Text="Branch Coverage: $(QualityGateBranchCoverage)% [FAILED]" Condition="'$(QualityGateBranchCoverage)' &lt; '$(QualityGateThreshold)'" />
    <Message Importance="High" Text="Required:        $(QualityGateThreshold).00%" />

    <Message
      Importance="High"
      Text="QUALITY GATE: PASSED"
      Condition="'$(QualityGateReportGeneratorExitCode)' == '0'" />

    <Message
      Importance="High"
      Text="QUALITY GATE: FAILED"
      Condition="'$(QualityGateReportGeneratorExitCode)' != '0'" />

    <Message
      Importance="High"
      Text="Reason: Line coverage and branch coverage are below the required threshold."
      Condition="'$(QualityGateReportGeneratorExitCode)' != '0' and '$(QualityGateLineCoverage)' &lt; '$(QualityGateThreshold)' and '$(QualityGateBranchCoverage)' &lt; '$(QualityGateThreshold)'" />

    <Message
      Importance="High"
      Text="Reason: Line coverage is below the required threshold."
      Condition="'$(QualityGateReportGeneratorExitCode)' != '0' and '$(QualityGateLineCoverage)' &lt; '$(QualityGateThreshold)' and '$(QualityGateBranchCoverage)' &gt;= '$(QualityGateThreshold)'" />

    <Message
      Importance="High"
      Text="Reason: Branch coverage is below the required threshold."
      Condition="'$(QualityGateReportGeneratorExitCode)' != '0' and '$(QualityGateLineCoverage)' &gt;= '$(QualityGateThreshold)' and '$(QualityGateBranchCoverage)' &lt; '$(QualityGateThreshold)'" />

    <Message Importance="High" Text="============================================================" />

    <Error
      Condition="'$(QualityGateReportGeneratorExitCode)' != '0'"
      Text="Quality Gate failed: line and/or branch coverage is below $(QualityGateThreshold)%." />
  </Target>

</Project>